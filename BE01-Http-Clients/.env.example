# ================================================================
# BE1_HttpAuth - Configuration
# Copy this file to .env (or edit src/.env) and fill in your values
# ================================================================

# Part 1: NewsAPI Key (register for free at https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# Part 2: HeadHunter internal shards parameters (defaults provided)
HH_VACANCY_ID=138003606
HH_EMPLOYER_ID=1455

# Part 3: Telegram Bot Credentials
# 1. Create a bot via @BotFather in Telegram and paste the token below:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Open Telegram, start your bot (/start), run `go run . tg` or check getUpdates
#    to find your chat_id and user_id, then paste them below:
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_USER_ID=your_user_id_here
